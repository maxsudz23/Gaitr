# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; this template is committed so teammates know
# which variables the app needs.
#
# For local dev, get these from the output of `supabase start` (or `supabase status`):
#   EXPO_PUBLIC_SUPABASE_URL                -> API_URL
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY    -> PUBLISHABLE_KEY
#
# Note: on the iOS simulator and web, 127.0.0.1 reaches your Mac. To test on a
# physical phone via Expo Go, replace 127.0.0.1 with your Mac's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
